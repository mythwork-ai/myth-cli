{
  "name": "myth",
  "version": "0.1.0",
  "description": "CLI for running and publishing mythwork apps",
  "type": "module",
  "bin": {
    "myth": "./dist/bin/myth.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@mythwork/shared": "^0.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ignore": "^7.0.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
